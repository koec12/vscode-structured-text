{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Siemens SCL",
  "scopeName": "source.siemens-scl",
  "comment": "GENERATED by scripts/build-grammars.ts - do not edit by hand.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#pragmas"
    },
    {
      "include": "#sclHeader"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#locals"
    },
    {
      "include": "#addresses"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#typeAnnotation"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.scl",
          "begin": "///",
          "end": "$",
          "patterns": [
            {
              "name": "meta.tag.documentation.scl",
              "match": "(</?)(summary|param|returns|para|remarks|example|c|code|see|value)\\b([^>]*)(>)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.tag.scl"
                },
                "2": {
                  "name": "entity.name.tag.scl"
                },
                "3": {
                  "patterns": [
                    {
                      "match": "(name)\\s*=\\s*(\"[^\"]*\"|“[^”]*”)",
                      "captures": {
                        "1": {
                          "name": "entity.other.attribute-name.scl"
                        },
                        "2": {
                          "name": "string.quoted.double.scl"
                        }
                      }
                    }
                  ]
                },
                "4": {
                  "name": "punctuation.definition.tag.scl"
                }
              }
            }
          ]
        },
        {
          "name": "comment.line.double-slash.scl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.scl",
          "begin": "\\(\\*",
          "end": "\\*\\)",
          "patterns": []
        },
        {
          "name": "comment.block.scl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "nestedComment": {
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "patterns": [
        {
          "include": "#nestedComment"
        }
      ]
    },
    "pragmas": {
      "patterns": [
        {
          "name": "meta.preprocessor.scl",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.preprocessor.scl"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.preprocessor.scl"
            }
          },
          "patterns": [
            {
              "name": "keyword.control.directive.scl",
              "match": "(?i)\\b(?:attribute|IF|ELSIF|ELSE|END_IF|define|undefine|region|endregion|info|warning|error|text|library|flag|message|S7_Optimized_Access|S7_m_c)\\b"
            },
            {
              "name": "string.quoted.single.scl",
              "match": "'[^']*'"
            },
            {
              "name": "string.quoted.double.scl",
              "match": "\"[^\"]*\""
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.scl",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.scl",
              "match": "\\$(?:[$'\"LNPRTlnprt]|[0-9A-Fa-f]{2})"
            }
          ]
        }
      ]
    },
    "sclHeader": {
      "patterns": [
        {
          "match": "(?i)^\\s*(TITLE)\\s*(=)(.*)$",
          "captures": {
            "1": {
              "name": "keyword.other.attribute.scl"
            },
            "2": {
              "name": "keyword.operator.scl"
            },
            "3": {
              "name": "string.unquoted.title.scl"
            }
          }
        },
        {
          "match": "(?i)^\\s*(VERSION|AUTHOR|FAMILY|NAME)\\s*(:)\\s*([^;]*?)\\s*$",
          "captures": {
            "1": {
              "name": "keyword.other.attribute.scl"
            },
            "2": {
              "name": "punctuation.separator.scl"
            },
            "3": {
              "name": "string.unquoted.attribute.scl"
            }
          }
        },
        {
          "match": "(?i)^\\s*(REGION)\\b(.*)$",
          "captures": {
            "1": {
              "name": "keyword.other.region.scl"
            },
            "2": {
              "name": "entity.name.section.region.scl"
            }
          }
        },
        {
          "name": "keyword.other.region.scl",
          "match": "(?i)\\bEND_REGION\\b"
        }
      ]
    },
    "locals": {
      "patterns": [
        {
          "match": "(?<![\\w#])(#)(\"[^\"]*\"|[A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.scl"
            },
            "2": {
              "name": "variable.other.local.scl"
            }
          }
        },
        {
          "name": "variable.other.global.scl",
          "match": "\"[^\"]*\""
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.time.scl",
          "match": "(?i)\\b(?:T|TIME|LT|LTIME|S5T|S5TIME)#[-+]?[0-9a-z_.]+"
        },
        {
          "name": "constant.numeric.date.scl",
          "match": "(?i)\\b(?:D|DATE|LD|LDATE|TOD|TIME_OF_DAY|LTOD|LTIME_OF_DAY|DT|DATE_AND_TIME|LDT|LDATE_AND_TIME|DTL)#[0-9_:.\\-]+"
        },
        {
          "match": "(?i)\\b([A-Z_]\\w*)(#)((?:\\d+#)?[-+]?[0-9A-Z_.]+|'[^']*')",
          "captures": {
            "1": {
              "name": "support.type.literal-prefix.scl"
            },
            "2": {
              "name": "punctuation.separator.literal.scl"
            },
            "3": {
              "name": "constant.numeric.typed.scl"
            }
          }
        },
        {
          "name": "constant.numeric.based.scl",
          "match": "\\b\\d+#[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.scl",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.language.boolean.scl",
          "match": "(?i)\\b(?:FALSE|TRUE)\\b"
        }
      ]
    },
    "addresses": {
      "patterns": [
        {
          "name": "variable.language.address.scl",
          "match": "%[A-Za-z]+[\\w.*]*[\\w*]"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?i)\\b(ORGANIZATION_BLOCK|FUNCTION_BLOCK|CONFIGURATION|DATA_BLOCK|FUNCTION|RESOURCE|PROGRAM)\\b((?:\\s+(?:PROTECTED|INTERNAL|ABSTRACT|PRIVATE|PUBLIC|FINAL)\\b)*)\\s+((?:\"[^\"]*\"|[A-Za-z_]\\w*))",
          "captures": {
            "1": {
              "name": "storage.type.pou.scl"
            },
            "2": {
              "name": "storage.modifier.scl"
            },
            "3": {
              "name": "entity.name.function.scl"
            }
          }
        },
        {
          "match": "(?i)\\b(TYPE)\\s+((?:\"[^\"]*\"|[A-Za-z_]\\w*))",
          "captures": {
            "1": {
              "name": "storage.type.pou.scl"
            },
            "2": {
              "name": "entity.name.type.scl"
            }
          }
        },
        {
          "match": "(?i)\\b(EXTENDS|IMPLEMENTS)\\s+((?:\"[^\"]*\"|[A-Za-z_]\\w*)(?:\\s*,\\s*(?:\"[^\"]*\"|[A-Za-z_]\\w*))*)",
          "captures": {
            "1": {
              "name": "storage.modifier.scl"
            },
            "2": {
              "name": "entity.other.inherited-class.scl"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.scl",
          "match": "(?i)\\b(?:END_REPEAT|END_WHILE|END_CASE|CONTINUE|END_FOR|END_IF|REPEAT|RETURN|ELSIF|WHILE|UNTIL|THEN|ELSE|CASE|EXIT|GOTO|FOR|JMP|IF|OF|TO|BY|DO)\\b"
        },
        {
          "name": "keyword.operator.logical.scl",
          "match": "(?i)\\b(?:AND_THEN|OR_ELSE|AND|XOR|NOT|OR)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.scl",
          "match": "(?i)\\b(?:MOD)\\b"
        },
        {
          "name": "storage.type.pou.scl",
          "match": "(?i)\\b(?:END_ORGANIZATION_BLOCK|END_FUNCTION_BLOCK|ORGANIZATION_BLOCK|END_CONFIGURATION|FUNCTION_BLOCK|END_DATA_BLOCK|CONFIGURATION|END_FUNCTION|END_RESOURCE|END_PROGRAM|END_STRUCT|DATA_BLOCK|END_REGION|FUNCTION|RESOURCE|END_TYPE|PROGRAM|STRUCT|REGION|BEGIN|TYPE)\\b"
        },
        {
          "name": "storage.modifier.var.scl",
          "match": "(?i)\\b(?:VAR_[A-Z_]+|VAR|END_VAR)\\b"
        },
        {
          "name": "storage.modifier.scl",
          "match": "(?i)\\b(?:KNOW_HOW_PROTECT|DB_SPECIFIC|NON_RETAIN|PERSISTENT|IMPLEMENTS|REFERENCE|PROTECTED|CONSTANT|ABSTRACT|INTERNAL|POINTER|EXTENDS|PRIVATE|RETAIN|PUBLIC|ARRAY|FINAL|TASK|WITH|AT|ON)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.scl",
          "match": "(?i)\\b(?:LDATE_AND_TIME|ANY_ELEMENTARY|DATE_AND_TIME|LTIME_OF_DAY|TIME_OF_DAY|ANY_DERIVED|IEC_COUNTER|ANY_STRING|IEC_LTIMER|BLOCK_SDB|IEC_TIMER|HW_DEVICE|EVENT_ANY|ANY_REAL|ANY_DATE|BLOCK_FC|BLOCK_FB|BLOCK_DB|CONN_ANY|WSTRING|ANY_NUM|ANY_INT|ANY_BIT|VARIANT|COUNTER|STRING|S5TIME|DB_ANY|DB_WWW|DB_DYN|HW_ANY|DWORD|LWORD|USINT|UDINT|ULINT|LREAL|LTIME|LDATE|WCHAR|TIMER|HW_IO|BOOL|BYTE|WORD|SINT|UINT|DINT|LINT|REAL|TIME|DATE|LTOD|CHAR|VOID|BIT|INT|TOD|LDT|ANY|DTL|DT)\\b"
        },
        {
          "name": "support.class.standard-fb.scl",
          "match": "(?i)\\b(?:R_TRIG|F_TRIG|TONR|LTON|LTOF|CTUD|SEMA|TON|TOF|LTP|CTU|CTD|TP|SR|RS)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.conversion.scl",
          "match": "(?i)\\b(?:(?:LDATE_AND_TIME|ANY_ELEMENTARY|DATE_AND_TIME|LTIME_OF_DAY|TIME_OF_DAY|ANY_DERIVED|IEC_COUNTER|ANY_STRING|IEC_LTIMER|BLOCK_SDB|IEC_TIMER|HW_DEVICE|EVENT_ANY|ANY_REAL|ANY_DATE|BLOCK_FC|BLOCK_FB|BLOCK_DB|CONN_ANY|WSTRING|ANY_NUM|ANY_INT|ANY_BIT|VARIANT|COUNTER|STRING|S5TIME|DB_ANY|DB_WWW|DB_DYN|HW_ANY|DWORD|LWORD|USINT|UDINT|ULINT|LREAL|LTIME|LDATE|WCHAR|TIMER|HW_IO|BOOL|BYTE|WORD|SINT|UINT|DINT|LINT|REAL|TIME|DATE|LTOD|CHAR|VOID|BIT|INT|TOD|LDT|ANY|DTL|DT|BCD)_TO_(?:BCD_)?(?:LDATE_AND_TIME|ANY_ELEMENTARY|DATE_AND_TIME|LTIME_OF_DAY|TIME_OF_DAY|ANY_DERIVED|IEC_COUNTER|ANY_STRING|IEC_LTIMER|BLOCK_SDB|IEC_TIMER|HW_DEVICE|EVENT_ANY|ANY_REAL|ANY_DATE|BLOCK_FC|BLOCK_FB|BLOCK_DB|CONN_ANY|WSTRING|ANY_NUM|ANY_INT|ANY_BIT|VARIANT|COUNTER|STRING|S5TIME|DB_ANY|DB_WWW|DB_DYN|HW_ANY|DWORD|LWORD|USINT|UDINT|ULINT|LREAL|LTIME|LDATE|WCHAR|TIMER|HW_IO|BOOL|BYTE|WORD|SINT|UINT|DINT|LINT|REAL|TIME|DATE|LTOD|CHAR|VOID|BIT|INT|TOD|LDT|ANY|DTL|DT|BCD)|TO_(?:LDATE_AND_TIME|ANY_ELEMENTARY|DATE_AND_TIME|LTIME_OF_DAY|TIME_OF_DAY|ANY_DERIVED|IEC_COUNTER|ANY_STRING|IEC_LTIMER|BLOCK_SDB|IEC_TIMER|HW_DEVICE|EVENT_ANY|ANY_REAL|ANY_DATE|BLOCK_FC|BLOCK_FB|BLOCK_DB|CONN_ANY|WSTRING|ANY_NUM|ANY_INT|ANY_BIT|VARIANT|COUNTER|STRING|S5TIME|DB_ANY|DB_WWW|DB_DYN|HW_ANY|DWORD|LWORD|USINT|UDINT|ULINT|LREAL|LTIME|LDATE|WCHAR|TIMER|HW_IO|BOOL|BYTE|WORD|SINT|UINT|DINT|LINT|REAL|TIME|DATE|LTOD|CHAR|VOID|BIT|INT|TOD|LDT|ANY|DTL|DT))\\b"
        },
        {
          "name": "support.function.builtin.scl",
          "match": "(?i)\\b(?:MOVE_BLK_VARIANT|GETINSTANCENAME|COUNTOFELEMENTS|TYPEOFELEMENTS|GETSYMBOLNAME|CHARS_TO_STRG|STRG_TO_CHARS|SET_TIMEZONE|LOWER_BOUND|UPPER_BOUND|DESERIALIZE|PEEK_DWORD|GET_ERR_ID|VARIANTGET|VARIANTPUT|PEEK_BOOL|PEEK_WORD|POKE_BOOL|UMOVE_BLK|UFILL_BLK|T_COMBINE|GET_ERROR|SERIALIZE|POKE_BLK|MOVE_BLK|FILL_BLK|RD_SYS_T|WR_SYS_T|RD_LOC_T|WR_LOC_T|STRG_VAL|VAL_STRG|IS_ARRAY|CTRL_PWM|REPLACE|ADRINST|INDEXOF|SCALE_X|RUNTIME|CONCAT|INSERT|DELETE|SIZEOF|BITADR|NORM_X|T_DIFF|T_CONV|S_CONV|TYPEOF|ATAN2|LIMIT|RIGHT|TRUNC|ROUND|FLOOR|T_ADD|T_SUB|SQRT|EXPT|ASIN|ACOS|ATAN|MOVE|LEFT|FIND|CEIL|FRAC|PEEK|POKE|SWAP|ABS|LOG|EXP|SIN|COS|TAN|ADD|SUB|MUL|DIV|MIN|MAX|SEL|MUX|SHL|SHR|ROL|ROR|LEN|MID|ADR|LN)\\b(?=\\s*\\()"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.scl",
          "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"
        }
      ]
    },
    "typeAnnotation": {
      "patterns": [
        {
          "match": "(?i)(?<=[^:]:)\\s*(?:\\b(LDATE_AND_TIME|ANY_ELEMENTARY|DATE_AND_TIME|LTIME_OF_DAY|TIME_OF_DAY|ANY_DERIVED|IEC_COUNTER|ANY_STRING|IEC_LTIMER|BLOCK_SDB|IEC_TIMER|HW_DEVICE|EVENT_ANY|ANY_REAL|ANY_DATE|BLOCK_FC|BLOCK_FB|BLOCK_DB|CONN_ANY|WSTRING|ANY_NUM|ANY_INT|ANY_BIT|VARIANT|COUNTER|STRING|S5TIME|DB_ANY|DB_WWW|DB_DYN|HW_ANY|DWORD|LWORD|USINT|UDINT|ULINT|LREAL|LTIME|LDATE|WCHAR|TIMER|HW_IO|BOOL|BYTE|WORD|SINT|UINT|DINT|LINT|REAL|TIME|DATE|LTOD|CHAR|VOID|BIT|INT|TOD|LDT|ANY|DTL|DT)\\b|(?!(?:END_ORGANIZATION_BLOCK|END_FUNCTION_BLOCK|ORGANIZATION_BLOCK|END_CONFIGURATION|KNOW_HOW_PROTECT|FUNCTION_BLOCK|END_DATA_BLOCK|CONFIGURATION|END_FUNCTION|END_RESOURCE|VAR_EXTERNAL|DB_SPECIFIC|END_PROGRAM|NON_RETAIN|PERSISTENT|IMPLEMENTS|END_STRUCT|DATA_BLOCK|END_REGION|VAR_OUTPUT|VAR_IN_OUT|VAR_GLOBAL|VAR_ACCESS|VAR_CONFIG|END_REPEAT|REFERENCE|PROTECTED|VAR_INPUT|END_WHILE|CONSTANT|ABSTRACT|INTERNAL|FUNCTION|RESOURCE|END_TYPE|VAR_TEMP|VAR_STAT|VAR_INST|END_CASE|CONTINUE|AND_THEN|POINTER|EXTENDS|PRIVATE|PROGRAM|END_VAR|END_FOR|OR_ELSE|RETAIN|PUBLIC|STRUCT|REGION|END_IF|REPEAT|RETURN|ARRAY|FINAL|BEGIN|ELSIF|WHILE|UNTIL|TASK|WITH|TYPE|THEN|ELSE|CASE|EXIT|GOTO|VAR|FOR|JMP|AND|XOR|NOT|MOD|AT|ON|IF|OF|TO|BY|DO|OR)\\b)([A-Za-z_]\\w*)\\b)(?!\\s*(?::=|\\(|\\.|#))",
          "captures": {
            "1": {
              "name": "support.type.primitive.scl"
            },
            "2": {
              "name": "entity.name.type.scl"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.scl",
          "match": ":=|=>|\\?="
        },
        {
          "name": "keyword.operator.comparison.scl",
          "match": "<>|<=|>=|=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.scl",
          "match": "\\*\\*|[-+*/]"
        },
        {
          "name": "keyword.operator.logical.scl",
          "match": "&"
        },
        {
          "name": "keyword.operator.dereference.scl",
          "match": "\\^"
        },
        {
          "name": "punctuation.separator.range.scl",
          "match": "\\.\\."
        },
        {
          "name": "punctuation.terminator.statement.scl",
          "match": ";"
        },
        {
          "name": "punctuation.separator.scl",
          "match": "[,:.]"
        },
        {
          "name": "punctuation.bracket.scl",
          "match": "[()\\[\\]]"
        }
      ]
    }
  }
}
