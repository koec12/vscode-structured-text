{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Structured Text (IEC 61131-3)",
  "scopeName": "source.iec-st",
  "comment": "GENERATED by scripts/build-grammars.ts - do not edit by hand.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#pragmas"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#addresses"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#typeAnnotation"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.st",
          "begin": "///",
          "end": "$",
          "patterns": [
            {
              "name": "meta.tag.documentation.st",
              "match": "(</?)(summary|param|returns|para|remarks|example|c|code|see|value)\\b([^>]*)(>)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.tag.st"
                },
                "2": {
                  "name": "entity.name.tag.st"
                },
                "3": {
                  "patterns": [
                    {
                      "match": "(name)\\s*=\\s*(\"[^\"]*\"|“[^”]*”)",
                      "captures": {
                        "1": {
                          "name": "entity.other.attribute-name.st"
                        },
                        "2": {
                          "name": "string.quoted.double.st"
                        }
                      }
                    }
                  ]
                },
                "4": {
                  "name": "punctuation.definition.tag.st"
                }
              }
            }
          ]
        },
        {
          "name": "comment.line.double-slash.st",
          "match": "//.*$"
        },
        {
          "name": "comment.block.st",
          "begin": "\\(\\*",
          "end": "\\*\\)",
          "patterns": [
            {
              "include": "#nestedComment"
            }
          ]
        },
        {
          "name": "comment.block.st",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "nestedComment": {
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "patterns": [
        {
          "include": "#nestedComment"
        }
      ]
    },
    "pragmas": {
      "patterns": [
        {
          "name": "meta.preprocessor.st",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.preprocessor.st"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.preprocessor.st"
            }
          },
          "patterns": [
            {
              "name": "keyword.control.directive.st",
              "match": "(?i)\\b(?:attribute|IF|ELSIF|ELSE|END_IF|define|undefine|region|endregion|info|warning|error|text|library|flag|message|S7_Optimized_Access|S7_m_c)\\b"
            },
            {
              "name": "string.quoted.single.st",
              "match": "'[^']*'"
            },
            {
              "name": "string.quoted.double.st",
              "match": "\"[^\"]*\""
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.st",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.st",
              "match": "\\$(?:[$'\"LNPRTlnprt]|[0-9A-Fa-f]{2})"
            }
          ]
        },
        {
          "name": "string.quoted.double.st",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.st",
              "match": "\\$(?:[$'\"LNPRTlnprt]|[0-9A-Fa-f]{4})"
            }
          ]
        }
      ]
    },
    "sclHeader": {
      "patterns": [
        {
          "match": "(?i)^\\s*(TITLE)\\s*(=)(.*)$",
          "captures": {
            "1": {
              "name": "keyword.other.attribute.st"
            },
            "2": {
              "name": "keyword.operator.st"
            },
            "3": {
              "name": "string.unquoted.title.st"
            }
          }
        },
        {
          "match": "(?i)^\\s*(VERSION|AUTHOR|FAMILY|NAME)\\s*(:)\\s*([^;]*?)\\s*$",
          "captures": {
            "1": {
              "name": "keyword.other.attribute.st"
            },
            "2": {
              "name": "punctuation.separator.st"
            },
            "3": {
              "name": "string.unquoted.attribute.st"
            }
          }
        },
        {
          "match": "(?i)^\\s*(REGION)\\b(.*)$",
          "captures": {
            "1": {
              "name": "keyword.other.region.st"
            },
            "2": {
              "name": "entity.name.section.region.st"
            }
          }
        },
        {
          "name": "keyword.other.region.st",
          "match": "(?i)\\bEND_REGION\\b"
        }
      ]
    },
    "locals": {
      "patterns": [
        {
          "match": "(?<![\\w#])(#)(\"[^\"]*\"|[A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.st"
            },
            "2": {
              "name": "variable.other.local.st"
            }
          }
        },
        {
          "name": "variable.other.global.st",
          "match": "\"[^\"]*\""
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.time.st",
          "match": "(?i)\\b(?:T|TIME|LT|LTIME|S5T|S5TIME)#[-+]?[0-9a-z_.]+"
        },
        {
          "name": "constant.numeric.date.st",
          "match": "(?i)\\b(?:D|DATE|LD|LDATE|TOD|TIME_OF_DAY|LTOD|LTIME_OF_DAY|DT|DATE_AND_TIME|LDT|LDATE_AND_TIME|DTL)#[0-9_:.\\-]+"
        },
        {
          "match": "(?i)\\b([A-Z_]\\w*)(#)((?:\\d+#)?[-+]?[0-9A-Z_.]+|'[^']*')",
          "captures": {
            "1": {
              "name": "support.type.literal-prefix.st"
            },
            "2": {
              "name": "punctuation.separator.literal.st"
            },
            "3": {
              "name": "constant.numeric.typed.st"
            }
          }
        },
        {
          "name": "constant.numeric.based.st",
          "match": "\\b\\d+#[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.st",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.language.boolean.st",
          "match": "(?i)\\b(?:FALSE|TRUE)\\b"
        }
      ]
    },
    "addresses": {
      "patterns": [
        {
          "name": "variable.language.address.st",
          "match": "%[A-Za-z]+[\\w.*]*[\\w*]"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?i)\\b(FUNCTION_BLOCK|CONFIGURATION|INTERFACE|NAMESPACE|FUNCTION|PROPERTY|RESOURCE|PROGRAM|METHOD|ACTION)\\b((?:\\s+(?:PROTECTED|INTERNAL|ABSTRACT|PRIVATE|PUBLIC|FINAL)\\b)*)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.pou.st"
            },
            "2": {
              "name": "storage.modifier.st"
            },
            "3": {
              "name": "entity.name.function.st"
            }
          }
        },
        {
          "match": "(?i)\\b(TYPE)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.pou.st"
            },
            "2": {
              "name": "entity.name.type.st"
            }
          }
        },
        {
          "match": "(?i)\\b(EXTENDS|IMPLEMENTS)\\s+([A-Za-z_]\\w*(?:\\s*,\\s*[A-Za-z_]\\w*)*)",
          "captures": {
            "1": {
              "name": "storage.modifier.st"
            },
            "2": {
              "name": "entity.other.inherited-class.st"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.st",
          "match": "(?i)\\b(?:END_REPEAT|END_WHILE|__FINALLY|END_CASE|CONTINUE|__ENDTRY|END_FOR|__CATCH|END_IF|REPEAT|RETURN|ELSIF|WHILE|UNTIL|__TRY|THEN|ELSE|CASE|EXIT|FOR|JMP|IF|OF|TO|BY|DO)\\b"
        },
        {
          "name": "keyword.operator.logical.st",
          "match": "(?i)\\b(?:AND_THEN|OR_ELSE|AND|XOR|NOT|OR)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.st",
          "match": "(?i)\\b(?:MOD)\\b"
        },
        {
          "name": "storage.type.pou.st",
          "match": "(?i)\\b(?:END_FUNCTION_BLOCK|END_CONFIGURATION|FUNCTION_BLOCK|CONFIGURATION|END_INTERFACE|END_NAMESPACE|END_FUNCTION|END_RESOURCE|END_PROPERTY|END_PROGRAM|END_STRUCT|END_METHOD|END_ACTION|INTERFACE|END_UNION|NAMESPACE|FUNCTION|RESOURCE|END_TYPE|PROPERTY|PROGRAM|STRUCT|METHOD|ACTION|BEGIN|UNION|TYPE)\\b"
        },
        {
          "name": "storage.modifier.var.st",
          "match": "(?i)\\b(?:VAR_[A-Z_]+|VAR|END_VAR)\\b"
        },
        {
          "name": "storage.modifier.st",
          "match": "(?i)\\b(?:NON_RETAIN|PERSISTENT|IMPLEMENTS|REFERENCE|PROTECTED|CONSTANT|ABSTRACT|INTERNAL|POINTER|EXTENDS|PRIVATE|RETAIN|PUBLIC|ARRAY|FINAL|TASK|WITH|AT|ON)\\b"
        },
        {
          "name": "variable.language.st",
          "match": "(?i)\\b(?:SUPER|THIS)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.st",
          "match": "(?i)\\b(?:LDATE_AND_TIME|ANY_ELEMENTARY|DATE_AND_TIME|LTIME_OF_DAY|TIME_OF_DAY|ANY_DERIVED|ANY_STRING|ANY_REAL|ANY_DATE|WSTRING|ANY_NUM|ANY_INT|ANY_BIT|__UXINT|__XWORD|STRING|__XINT|DWORD|LWORD|USINT|UDINT|ULINT|LREAL|LTIME|LDATE|WCHAR|UXINT|XWORD|BOOL|BYTE|WORD|SINT|UINT|DINT|LINT|REAL|TIME|DATE|LTOD|CHAR|XINT|BIT|INT|TOD|LDT|ANY|DT)\\b"
        },
        {
          "name": "support.class.standard-fb.st",
          "match": "(?i)\\b(?:R_TRIG|F_TRIG|TONR|LTON|LTOF|CTUD|SEMA|TON|TOF|LTP|CTU|CTD|TP|SR|RS)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.conversion.st",
          "match": "(?i)\\b(?:(?:LDATE_AND_TIME|ANY_ELEMENTARY|DATE_AND_TIME|LTIME_OF_DAY|TIME_OF_DAY|ANY_DERIVED|ANY_STRING|ANY_REAL|ANY_DATE|WSTRING|ANY_NUM|ANY_INT|ANY_BIT|__UXINT|__XWORD|STRING|__XINT|DWORD|LWORD|USINT|UDINT|ULINT|LREAL|LTIME|LDATE|WCHAR|UXINT|XWORD|BOOL|BYTE|WORD|SINT|UINT|DINT|LINT|REAL|TIME|DATE|LTOD|CHAR|XINT|BIT|INT|TOD|LDT|ANY|DT|BCD)_TO_(?:BCD_)?(?:LDATE_AND_TIME|ANY_ELEMENTARY|DATE_AND_TIME|LTIME_OF_DAY|TIME_OF_DAY|ANY_DERIVED|ANY_STRING|ANY_REAL|ANY_DATE|WSTRING|ANY_NUM|ANY_INT|ANY_BIT|__UXINT|__XWORD|STRING|__XINT|DWORD|LWORD|USINT|UDINT|ULINT|LREAL|LTIME|LDATE|WCHAR|UXINT|XWORD|BOOL|BYTE|WORD|SINT|UINT|DINT|LINT|REAL|TIME|DATE|LTOD|CHAR|XINT|BIT|INT|TOD|LDT|ANY|DT|BCD)|TO_(?:LDATE_AND_TIME|ANY_ELEMENTARY|DATE_AND_TIME|LTIME_OF_DAY|TIME_OF_DAY|ANY_DERIVED|ANY_STRING|ANY_REAL|ANY_DATE|WSTRING|ANY_NUM|ANY_INT|ANY_BIT|__UXINT|__XWORD|STRING|__XINT|DWORD|LWORD|USINT|UDINT|ULINT|LREAL|LTIME|LDATE|WCHAR|UXINT|XWORD|BOOL|BYTE|WORD|SINT|UINT|DINT|LINT|REAL|TIME|DATE|LTOD|CHAR|XINT|BIT|INT|TOD|LDT|ANY|DT))\\b"
        },
        {
          "name": "support.function.builtin.st",
          "match": "(?i)\\b(?:__COMPARE_AND_SWAP|__QUERYINTERFACE|__QUERYPOINTER|__ISVALIDREF|TEST_AND_SET|LOWER_BOUND|UPPER_BOUND|__VARINFO|__DELETE|REPLACE|ADRINST|INDEXOF|CONCAT|INSERT|DELETE|SIZEOF|BITADR|__XADD|ATAN2|LIMIT|RIGHT|TRUNC|ROUND|FLOOR|__NEW|SQRT|EXPT|ASIN|ACOS|ATAN|MOVE|LEFT|FIND|CEIL|FRAC|ABS|LOG|EXP|SIN|COS|TAN|ADD|SUB|MUL|DIV|MIN|MAX|SEL|MUX|SHL|SHR|ROL|ROR|LEN|MID|ADR|LN)\\b(?=\\s*\\()"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.st",
          "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"
        }
      ]
    },
    "typeAnnotation": {
      "patterns": [
        {
          "match": "(?i)(?<=[^:]:)\\s*(?:\\b(LDATE_AND_TIME|ANY_ELEMENTARY|DATE_AND_TIME|LTIME_OF_DAY|TIME_OF_DAY|ANY_DERIVED|ANY_STRING|ANY_REAL|ANY_DATE|WSTRING|ANY_NUM|ANY_INT|ANY_BIT|__UXINT|__XWORD|STRING|__XINT|DWORD|LWORD|USINT|UDINT|ULINT|LREAL|LTIME|LDATE|WCHAR|UXINT|XWORD|BOOL|BYTE|WORD|SINT|UINT|DINT|LINT|REAL|TIME|DATE|LTOD|CHAR|XINT|BIT|INT|TOD|LDT|ANY|DT)\\b|(?!(?:END_FUNCTION_BLOCK|END_CONFIGURATION|FUNCTION_BLOCK|CONFIGURATION|END_INTERFACE|END_NAMESPACE|END_FUNCTION|END_RESOURCE|END_PROPERTY|VAR_EXTERNAL|END_PROGRAM|NON_RETAIN|PERSISTENT|IMPLEMENTS|END_STRUCT|END_METHOD|END_ACTION|VAR_OUTPUT|VAR_IN_OUT|VAR_GLOBAL|VAR_ACCESS|VAR_CONFIG|END_REPEAT|REFERENCE|PROTECTED|INTERFACE|END_UNION|NAMESPACE|VAR_INPUT|END_WHILE|__FINALLY|CONSTANT|ABSTRACT|INTERNAL|FUNCTION|RESOURCE|END_TYPE|PROPERTY|VAR_TEMP|VAR_STAT|VAR_INST|END_CASE|CONTINUE|__ENDTRY|AND_THEN|POINTER|EXTENDS|PRIVATE|PROGRAM|END_VAR|END_FOR|__CATCH|OR_ELSE|RETAIN|PUBLIC|STRUCT|METHOD|ACTION|END_IF|REPEAT|RETURN|ARRAY|FINAL|BEGIN|UNION|ELSIF|WHILE|UNTIL|__TRY|TASK|WITH|TYPE|THEN|ELSE|CASE|EXIT|VAR|FOR|JMP|AND|XOR|NOT|MOD|AT|ON|IF|OF|TO|BY|DO|OR)\\b)([A-Za-z_]\\w*)\\b)(?!\\s*(?::=|\\(|\\.|#))",
          "captures": {
            "1": {
              "name": "support.type.primitive.st"
            },
            "2": {
              "name": "entity.name.type.st"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.st",
          "match": "(?i)\\b(?:S|R|REF)=(?![=>])"
        },
        {
          "name": "keyword.operator.assignment.st",
          "match": ":=|=>|\\?="
        },
        {
          "name": "keyword.operator.comparison.st",
          "match": "<>|<=|>=|=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.st",
          "match": "\\*\\*|[-+*/]"
        },
        {
          "name": "keyword.operator.logical.st",
          "match": "&"
        },
        {
          "name": "keyword.operator.dereference.st",
          "match": "\\^"
        },
        {
          "name": "punctuation.separator.range.st",
          "match": "\\.\\."
        },
        {
          "name": "punctuation.terminator.statement.st",
          "match": ";"
        },
        {
          "name": "punctuation.separator.st",
          "match": "[,:.]"
        },
        {
          "name": "punctuation.bracket.st",
          "match": "[()\\[\\]]"
        }
      ]
    }
  }
}
